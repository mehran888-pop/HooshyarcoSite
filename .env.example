# ===== اتصال وردپرس (Headless) =====
# وقتی خالی باشد، حالت دمو (Mock) با داده نمونه فعال است.
VITE_WP_URL=
VITE_WP_URL_2=
VITE_DEMO_MODE=true

# ===== احراز هویت JWT (افزونه JWT Authentication for WP REST API) =====
# مسیر دریافت توکن: /wp-json/jwt-auth/v1/token
# (کلیدها فقط سمت سرور باید بمانند؛ این‌ها صرفاً برای توسعه است)

# ===== ووکامرس (فقط سمت سرور) =====
VITE_WC_CONSUMER_KEY=
VITE_WC_CONSUMER_SECRET=

# ===== ربات اطلاع‌رسانی بله =====
VITE_BALE_API=
VITE_BALE_TOKEN=
VITE_BALE_CHANNEL=

# ===== شناسه فرم‌های گراویتی‌فرم =====
VITE_GF_EMPLOYMENT=1
VITE_GF_CONSULTATION=2
VITE_GF_CONTACT=3

# ===== سامانه‌های پیامکی =====
# ملی‌پیامک، sms.ir، ippanel.co — تنظیمات سمت سرور
